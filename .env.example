# ============================================================
# APPLICATION
# ============================================================

APP_NAME=AI Course Engine
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000


# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql+asyncpg://course_engine:course_engine@postgres:5432/course_engine

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800


# ============================================================
# REDIS
# ============================================================

REDIS_URL=redis://redis:6379/0


# ============================================================
# SECURITY
# ============================================================

SECRET_KEY=replace-this-with-a-long-random-secret

ALLOWED_HOSTS=["localhost","127.0.0.1"]

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720


# ============================================================
# AUTHENTICATION
# ============================================================

# --- Open self-registration (lecturer accounts only) ---

# When false, POST /auth/register is refused and the app hides the
# "create an account" link. Admins can still create users by hand.
AUTH_REGISTRATION_ENABLED=true

# Optional email-domain allowlist, lower-case and without the "@".
# An empty list accepts any syntactically valid address.
# AUTH_REGISTRATION_ALLOWED_DOMAINS=["gmail.com"]


# --- "Sign in with Google" (OAuth 2.0 authorization code flow) ---

# Google is reported as unavailable until the client id, secret and an
# absolute redirect URI are all set, so the button is hidden rather than
# shown broken. There is no separate enabled flag; configuration is the flag.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must be an ABSOLUTE URI and must exactly match a redirect URI registered on
# the Google Cloud OAuth client. A relative path is rejected by Google.
# The API must be reachable at this URL, so "localhost" is fine locally but
# needs a public HTTPS hostname once deployed.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Where the browser lands after the API mints a one-time code. The access
# token is never placed in the URL, so a relative default is safe.
GOOGLE_OAUTH_FRONTEND_REDIRECT=/login

# Lifetime of the one-time handoff code. Kept short on purpose: it is a
# bearer credential for the login it authorises.
GOOGLE_OAUTH_EXCHANGE_TTL_SECONDS=300

# Timeout for the token and userinfo calls made to Google.
GOOGLE_OAUTH_TIMEOUT_SECONDS=10


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
LOG_JSON=false


# ============================================================
# FILE PROCESSING
# ============================================================

MAX_UPLOAD_SIZE_MB=50


# ============================================================
# AI PROVIDER
# ============================================================

# Select the LLM backend. OpenRouter is the production default;
# OpenAI remains an optional alternative.
# AI_PROVIDER=openrouter

# --- OpenAI (optional alternative) ---
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter (production) ---
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=300
# OPENROUTER_MAX_ATTEMPTS=3
# OPENROUTER_MAX_RETRIES=5
# OPENROUTER_RETRY_BASE_DELAY_SECONDS=2.0
# OPENROUTER_MAX_RETRY_DELAY_SECONDS=120.0

# Per-chapter extraction prompt limits (provider-agnostic).
# AI_EXTRACT_TEMPERATURE=0
# AI_EXTRACT_MAX_TOKENS=2560
# AI_EXTRACT_MAX_TOPICS=6
# AI_EXTRACT_MAX_OBJECTIVES=3
# AI_EXTRACT_MAX_CONCEPTS=3
# AI_EXTRACT_MAX_PREREQUISITES=2

# Cap the per-chapter context sent to the LLM (chars). Chunks beyond
# this bound are omitted (never fabricated) and their provenance markers
# are dropped. Keep it small enough to fit inside the model's context
# window along with the prompt and bounded output.
# AI_MAX_CONTEXT_CHARS=6000

# A chapter whose bounded context text is shorter than this many chars
# is skipped without an LLM call (no topics are invented for header-only
# or table-of-contents pages).
# AI_MIN_CONTENT_CHARS=500


# ============================================================
# MOODLE INTEGRATION
# ============================================================

# Moodle base URL (the web service REST endpoint is derived from this).
# MOODLE_URL=http://localhost/moodle
# MOODLE_TOKEN=replace-with-a-moodle-web-service-token
# MOODLE_TIMEOUT_SECONDS=30.0
# MOODLE_COURSE_CATEGORY_ID=1