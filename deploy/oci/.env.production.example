# Copy to .env.production, replace every CHANGE_ME value, then:
#   chmod 600 .env.production
# Never commit .env.production.
#
# Generate URL-safe secrets with:
#   openssl rand -hex 32

# ---------------------------------------------------------------------------
# Compose and Caddy
# ---------------------------------------------------------------------------
CADDY_DOMAIN=api.skillupactionafrica.co.ke
# Do not populate or deploy with a real value until the owner has approved an
# ACME contact address. Caddy will not request a production certificate while
# this remains a placeholder; validate_env.py rejects it.
ACME_EMAIL=CHANGE_ME_ACME_CONTACT_EMAIL
APP_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# PostgreSQL container
# ---------------------------------------------------------------------------
# Use hex so the password needs no URL encoding in DATABASE_URL.
POSTGRES_DB=course_engine
POSTGRES_USER=course_engine
POSTGRES_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_32
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_LOG_MIN_DURATION_MS=1000

# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://course_engine:CHANGE_ME_USE_openssl_rand_hex_32@postgres:5432/course_engine
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Redis container (not password protected; not published to the host)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=SkillUp Action Africa
APP_TAGLINE=Course Intelligence Workspace
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

CORS_ORIGINS=["https://skillupactionafrica.co.ke","https://www.skillupactionafrica.co.ke"]
FRONTEND_URL=https://skillupactionafrica.co.ke
ALLOWED_HOSTS=["api.skillupactionafrica.co.ke","skillupactionafrica.co.ke","www.skillupactionafrica.co.ke"]

SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

AUTH_REGISTRATION_ENABLED=true
AUTH_REGISTRATION_ALLOWED_DOMAINS=[]
LEARNER_DESTINATION=/learn
ASSESSMENT_PASS_PERCENT=70

# The OCI stack is reachable only through Caddy, which appends the real
# client address to X-Forwarded-For. Keep this false if the API is ever
# exposed directly.
TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------------
# Logging and uploads
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/storage/documents
# Kept false because the OCI stack runs ingestion-worker as its own service.
RUN_INGESTION_WORKER=false

# ---------------------------------------------------------------------------
# Google OAuth (must exactly match the Google Cloud console redirect URI)
# ---------------------------------------------------------------------------
# Keep GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET empty until the
# owner approves the credentials and callback URL. The callback below is
# prepared; it is not active while the client credentials are empty, and the
# sign-in page hides Google until both are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.skillupactionafrica.co.ke/api/v1/auth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT=/login
GOOGLE_OAUTH_EXCHANGE_TTL_SECONDS=300
GOOGLE_OAUTH_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=CHANGE_ME_APPROVED_OPENROUTER_MODEL
OPENROUTER_TIMEOUT_SECONDS=300
YOUTUBE_API_KEY=

# Optional OpenAI alternative; leave disabled while AI_PROVIDER=openrouter.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Moodle (existing production installation; do not point at the new app)
# ---------------------------------------------------------------------------
# `skillupafrica.co.ke` is the Moodle domain and is NOT interchangeable with
# the application domain `skillupactionafrica.co.ke`. Do not create, modify,
# migrate, or delete Moodle records as part of this deployment.
MOODLE_URL=https://elearning.skillupafrica.co.ke
MOODLE_TOKEN=CHANGE_ME_MOODLE_WEB_SERVICE_TOKEN
MOODLE_TIMEOUT_SECONDS=30
MOODLE_COURSE_CATEGORY_ID=1

# ---------------------------------------------------------------------------
# Backups (used by deploy/oci/backup.sh)
# ---------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
